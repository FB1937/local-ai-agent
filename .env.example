SEARXNG_URL=http://localhost:8080
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Optional: route to SEARCH when the model's self-reported confidence is below this value.
ROUTER_CONFIDENCE_THRESHOLD=0.55

# Optional: timeout in seconds for the routing call to Ollama.
ROUTER_TIMEOUT=120

# Optional: enable extended thinking on the first SEARCH/HYBRID generation attempt (default: disabled).
OLLAMA_SEARCH_THINKING=0
