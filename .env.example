SEARXNG_URL=http://localhost:8080
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Optional: route to SEARCH when the model's self-reported confidence is below this value.
ROUTER_CONFIDENCE_THRESHOLD=0.55

# Optional: timeout in seconds for the routing call to Ollama.
ROUTER_TIMEOUT=120

# Optional: enable multilingual semantic passage retrieval through Ollama.
# Install once with: ollama pull bge-m3
# When disabled or unavailable, the agent uses deterministic lexical retrieval.
ENABLE_SEMANTIC_RETRIEVAL=0
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_TIMEOUT=60
OLLAMA_EMBEDDING_MIN_SCORE=0.35
